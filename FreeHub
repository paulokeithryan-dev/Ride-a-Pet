                                local nest = nestsFolder:FindFirstChild(tostring(nestId))
                                if nest and IsNestFree(nest) then
                                    eggPlaced:FireServer({
                                        NestId = tostring(nestId)
                                    })
                                    task.wait(0.1)
                                end
                            end
                        end
                    end
                    task.wait(0.5)
                end
            end)
        end
    end,
})

