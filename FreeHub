})

-- Dynamic Multiselect & ESP Updater Loop
local function FetchEggNames()
    local renderedFolder = Workspace:FindFirstChild("RenderedEggs")
    local eggSet = {}
    local uniqueNames = {}

    if renderedFolder then
        for _, egg in ipairs(renderedFolder:GetChildren()) do
            if not eggSet[egg.Name] then
                eggSet[egg.Name] = true
                table.insert(uniqueNames, egg.Name)
            end

            if EggESPEnabled and not ActiveHighlights[egg] then
                local hl = Instance.new("Highlight")
                hl.Adornee = egg
                hl.FillColor = Color3.fromRGB(255, 215, 0)
                hl.Parent = egg
                ActiveHighlights[egg] = hl
            end
        end
    end
    return uniqueNames
end

task.spawn(function()
    while task.wait(2) do
        local updatedList = FetchEggNames()
        if #updatedList > 0 then
            EggDropdown:Refresh(updatedList)
        end
    end
end)
