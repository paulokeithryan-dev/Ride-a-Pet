local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local Window = Rayfield:CreateWindow({
    Name = "Egg Hub",
    LoadingTitle = "Rayfield Gen2 Interface",
    ConfigurationSaving = {
        Enabled = false
    }
})

-- Fixed: Passed as a table dictionary
local Tab = Window:CreateTab({
    Name = "Egg Automation",
    Icon = 4483362458
})

-- Services & State Variables
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local SelectedEggs = {}
local GlideSpeed = 50
local AutofarmEnabled = false
local EggESPEnabled = false
local ActiveHighlights = {}

-- Plot Verification Helper
local function GetPlayerPlot()
    if not Workspace:FindFirstChild("Plots") then return nil end
    for _, plot in ipairs(Workspace.Plots:GetChildren()) do
        local data = plot:FindFirstChild("Data")
        if data and data:FindFirstChild("Owner") then
            local ownerVal = data.Owner.Value
            if ownerVal == LocalPlayer or ownerVal == LocalPlayer.Name then
                return plot
            end
        end
    end
    return nil
end

-- Glide Movement Helper
local function GlideTo(targetPosition)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local hrp = char.HumanoidRootPart

    while AutofarmEnabled and char and hrp do
        local currentPos = hrp.Position
        local distance = (targetPosition - currentPos).Magnitude
        
        if distance <= 5 then break end

        local direction = (targetPosition - currentPos).Unit
        local dt = RunService.Heartbeat:Wait()
        hrp.CFrame = CFrame.new(hrp.Position + (direction * (GlideSpeed * dt)), targetPosition)
    end
    return AutofarmEnabled
end

-- 1. Egg ESP Toggle
Tab:CreateToggle({
    Name = "Egg ESP",
    CurrentValue = false,
    Flag = "EggESP",
    Callback = function(Value)
        EggESPEnabled = Value
        if not Value then
            for _, hl in pairs(ActiveHighlights) do
                if hl then hl:Destroy() end
            end
            table.clear(ActiveHighlights)
        end
    end,
})

-- 2. Autofarm Egg Toggle
Tab:CreateToggle({
    Name = "Autofarm Egg",
    CurrentValue = false,
    Flag = "AutofarmEgg",
    Callback = function(Value)
        AutofarmEnabled = Value
        if Value then
            task.spawn(function()
                while AutofarmEnabled do
                    local renderedFolder = Workspace:FindFirstChild("RenderedEggs")
                    local playerPlot = GetPlayerPlot()

                    if renderedFolder and playerPlot then
                        for _, egg in ipairs(renderedFolder:GetChildren()) do
                            if not AutofarmEnabled then break end

                            if table.find(SelectedEggs, egg.Name) or #SelectedEggs == 0 then
                                local targetPos = egg:IsA("Model") and egg:GetPivot().Position or egg.Position
                                local plotPos = playerPlot:IsA("Model") and playerPlot:GetPivot().Position or playerPlot.Position

                                if GlideTo(targetPos) then
                                    task.wait(0.3)
                                    GlideTo(plotPos)
                                    task.wait(0.5)
                                end
                            end
                        end
                    end
                    task.wait(1)
                end
            end)
        end
    end,
})

-- 3. Glide Speed Slider
Tab:CreateSlider({
    Name = "Autofarm Egg Glide Speed",
    Range = {10, 300},
    Increment = 5,
    Suffix = " studs/sec",
    CurrentValue = 50,
    Flag = "GlideSpeed",
    Callback = function(Value)
        GlideSpeed = Value
    end,
})

-- 4. Dynamic Multiselect Dropdown
local EggDropdown = Tab:CreateDropdown({
    Name = "Select Target Eggs",
    Options = {"Loading..."},
    MultipleOptions = true,
    Flag = "EggSelection",
    Callback = function(Options)
        SelectedEggs = Options
    end,
})

-- Realtime Dropdown List & ESP Sync
local function FetchEggNames()
    local renderedFolder = Workspace:FindFirstChild("RenderedEggs")
    local eggSet = {}
    local uniqueNames = {}

    if renderedFolder then
        for _, egg in ipairs(renderedFolder:GetChildren()) do
            if not eggSet[egg.Name] then
                eggSet[egg.Name] = true
                table.insert(uniqueNames, egg.Name)
            end

            if EggESPEnabled and not ActiveHighlights[egg] then
                local hl = Instance.new("Highlight")
                hl.Adornee = egg
                hl.FillColor = Color3.fromRGB(255, 215, 0)
                hl.Parent = egg
                ActiveHighlights[egg] = hl
            end
        end
    end
    return uniqueNames
end

task.spawn(function()
    while task.wait(2) do
        local updatedList = FetchEggNames()
        if #updatedList > 0 then
            EggDropdown:Refresh(updatedList)
        end
    end
end)
