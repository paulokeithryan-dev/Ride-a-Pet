-- Robust notification helper that prevents any crashing
local function SafeNotify(data)
    pcall(function()
        if type(Rayfield) == "table" then
            if typeof(Rayfield.Notify) == "function" then
                Rayfield:Notify(data)
            elseif data and data.Title and data.Content then
                print("[Egg Hub Notification] " .. data.Title .. ": " .. data.Content)
            end
        end
    end)
end

