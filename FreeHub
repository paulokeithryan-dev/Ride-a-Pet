-- Live Dashboard Update Loop
task.spawn(function()
    while task.wait(0.5) do
        -- Calculate Session Time
        local elapsed = os.time() - SessionStartTime
        local hours = math.floor(elapsed / 3600)
        local mins = math.floor((elapsed % 3600) / 60)
        local secs = elapsed % 60
        local sessionStr = string.format("%dh %dm %ds", hours, mins, secs)

        -- Calculate FPS & Ping
        local ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue())
        local fps = math.floor(Workspace:GetRealPhysicsFPS())
        local activeFeatures = (AutofarmEnabled and 1 or 0) + (EggESPEnabled and 1 or 0) + (AutoNestEnabled and 1 or 0) + (AutoHatchEnabled and 1 or 0)

        -- Update Home Tab Paragraphs
        StatusParagraph:Set({
            Title = "Status Overview",
            Content = string.format("⏱️ Session Time: %s\n⚡ Features On: %d\n🎯 FPS: %d\n📶 Ping: %d ms", sessionStr, activeFeatures, fps, ping)
        })

        ServerParagraph:Set({
            Title = "Server Details",
